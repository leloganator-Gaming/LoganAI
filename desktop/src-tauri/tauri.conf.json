{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoganAI",
  "version": "0.1.0",
  "identifier": "fr.loganai.desktop",
  "build": {"beforeBuildCommand": "", "beforeDevCommand": "", "frontendDist": "../"},
  "app": {
    "windows": [{"title": "LoganAI", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 560}],
    "security": {"csp": "default-src 'self' http://127.0.0.1:8000; connect-src 'self' http://127.0.0.1:8000; img-src 'self' asset: data: blob:"}
  },
  "bundle": {"active": true, "targets": ["msi", "nsis"]}
}
